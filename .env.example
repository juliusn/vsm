# Use the URL and public key from the local Supabase stack for local development.
# For hosted environments, copy the matching project URL and publishable key from Connect.
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_KEY=your-anon-or-publishable-key

# Update these with the SMTP account settings of your email service provider:
SMTP_HOST=smtp.your-service-provider.com
SMTP_PORT=465
SMTP_USER=no-reply@your-domain.com
SMTP_PASS=your-smtp-pass
SMTP_ADMIN_EMAIL=vanaheim@vanaheim.fi
SMTP_SENDER_NAME=Vanaheim Email Service
